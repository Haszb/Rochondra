# Template for .env — copy this file to .env and fill in real values.
# .env itself is never committed. Non-secret settings live in config.toml.

# --- PostgreSQL ---
POSTGRES_USER=rochondra
POSTGRES_PASSWORD=change-me

# --- MinIO ---
MINIO_ACCESS_KEY=rochondra
MINIO_SECRET_KEY=change-me

# --- Redis ---
# Leave empty when Redis has no password (the dev container has none).
REDIS_PASSWORD=

# --- API ---
SESSION_SECRET_KEY=generate-with-python-c-import-secrets-print-secrets-token_urlsafe-48

# --- Ollama ---
# Only needed once CLI-account auth is replaced by an API key.
OLLAMA_API_KEY=

# --- Per-service host overrides (optional) ---
# Every service defaults to the host in config.toml's main_url. Uncomment one
# of these only when that service lives somewhere else (e.g. managed Postgres).
# POSTGRES_HOST=db.example.com
# REDIS_HOST=
# MINIO_HOST=
# OLLAMA_HOST=
